# 이 파일을 .env 로 복사한 뒤 값을 채우세요 (로컬 테스트용).
# GitHub Actions 에서는 저장소 Settings > Secrets 에 동일한 이름으로 등록합니다.

# Product Hunt Developer Token
# https://www.producthunt.com/v2/oauth/applications
PRODUCTHUNT_TOKEN=

# Reddit script 앱 (https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=idea-dashboard/0.1 by your-reddit-username

# Claude API (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# 분석 모델 (선택). 기본: claude-sonnet-4-6 (비용 절감)
# 더 깊은 분석은 claude-opus-4-8
CLAUDE_MODEL=claude-sonnet-4-6
